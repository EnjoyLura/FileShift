# ============ 应用配置 ============
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# ============ 数据库 ============
DATABASE_URL=postgresql://fileshift:fileshift123@localhost:5432/fileshift

# ============ Redis ============
REDIS_URL=redis://localhost:6379

# ============ JWT ============
JWT_ACCESS_SECRET=change-this-to-a-random-secret-in-production
JWT_REFRESH_SECRET=change-this-to-another-random-secret

# ============ 微信登录 ============
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=http://localhost:3000/api/v1/auth/wechat/callback

# ============ 邮箱服务 ============
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ============ 阿里云短信 ============
ALI_ACCESS_KEY_ID=
ALI_ACCESS_KEY_SECRET=
ALI_SMS_TEMPLATE_CODE=

# ============ 微信支付 ============
WX_PAY_APPID=
WX_PAY_MCHID=
WX_PAY_SERIAL_NO=
WX_PAY_KEY=

# ============ 支付宝 ============
ALIPAY_APPID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# ============ 文件存储 ============
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/outputs
TEMP_DIR=./data/temp
MAX_FILE_SIZE_MB=200

# ============ LibreOffice ============
# LibreOffice 可执行文件路径（不设置则自动检测）
# Windows: C:\Program Files\LibreOffice\program\soffice.exe
# macOS: /Applications/LibreOffice.app/Contents/MacOS/soffice
# Linux: /usr/bin/soffice
# LIBREOFFICE_PATH=
